PORT=3000
HOST=127.0.0.1
BASE_URL=http://localhost:3000

# Local connections; Compose uses the internal service names and ports.
DB_HOST=localhost
DB_PORT=5432
DB_USER=url_shortener
DB_PASSWORD=local_dev_password
